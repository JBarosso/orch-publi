{
  "manifest_version": 3,
  "name": "Orch-Publi — Capture programmations Salesforce",
  "version": "1.0.3",
  "description": "Capture les programmations (locales + dates) définies dans Salesforce Page Designer pour les importer dans le dashboard orch-publi sans double saisie.",
  "key": "",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "https://staging-store-orchestra.demandware.net/*",
    "https://fr.staging-orchestra.fr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://staging-store-orchestra.demandware.net/*",
        "https://fr.staging-orchestra.fr/*"
      ],
      "all_frames": true,
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "http://localhost:*/*"
    ]
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Programmations Salesforce"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
